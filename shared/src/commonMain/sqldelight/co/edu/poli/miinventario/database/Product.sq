
CREATE TABLE product (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    quantity REAL NOT NULL,
    unit TEXT NOT NULL,
    minimumQuantity REAL NOT NULL
);

insertProduct:
INSERT INTO product (
    id,
    name,
    category,
    quantity,
    unit,
    minimumQuantity
)
VALUES (?, ?, ?, ?, ?, ?);

selectAllProducts:
SELECT *
FROM product
ORDER BY name ASC;

updateProduct:
UPDATE product
SET name = ?, category = ?, quantity = ?, unit = ?, minimumQuantity = ?
WHERE id = ?;

selectProductById:
SELECT id FROM product WHERE id = ?;

deleteProduct:
DELETE FROM product WHERE id = ?;

updateProductQuantity:
UPDATE product SET quantity = ? WHERE id = ?;
